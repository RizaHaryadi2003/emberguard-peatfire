# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# hasil tangkapan layar Playwright MCP
.playwright-mcp/

# ---------------------------------------------------------------------------
# Pengaturan lokal Claude Code & skill pihak ketiga (bukan karya sendiri, 5 MB)
# ---------------------------------------------------------------------------
.claude/

# ---------------------------------------------------------------------------
# Dokumen skripsi, berkas administrasi, dan bahan pihak ketiga.
# Semua ini tidak dipublikasikan: sebagian bersifat pribadi (absen, surat
# pernyataan), sebagian berhak cipta (jurnal, handout kampus), sebagian hanya
# arsip unduhan (zip skill & MCP, 29 MB).
# Aturannya: seluruh isi docs/ diabaikan KECUALI dokumentasi teknis dan
# tangkapan layar hasil pengujian.
# ---------------------------------------------------------------------------
/docs/*
!/docs/md/
!/docs/screenshots/

# Berkas sementara Microsoft Word (mis. "~$nama.docx")
~$*

# ---------------------------------------------------------------------------
# Keluaran sementara di akar proyek: naskah hasil olahan Claude Code dan
# tangkapan layar pengukuran performa. Tangkapan layar yang dipakai di naskah
# disimpan di docs/screenshots/, bukan di sini.
# ---------------------------------------------------------------------------
/Claude outputs/
/*.png
